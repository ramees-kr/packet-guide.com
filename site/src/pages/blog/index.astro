---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, readingMinutes, slugFromEntry, sortByNewest } from "@/lib/site";

const posts = sortByNewest(await getCollection("blog"));
---

<BaseLayout title="Blog" description="Technical notes and learning logs from Packet Guide.">
  <section class="listing-page">
    <header class="listing-header">
      <p class="eyebrow">Field notes</p>
      <h1>Blog</h1>
      <p>Short explanations, project writeups, and practical notes from networking, Redis, DNS, and infrastructure work.</p>
    </header>

    <div class="grid">
      {
        posts.map((post) => (
          <a class="card" href={`/blog/${slugFromEntry(post)}`}>
            <div class="meta">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span>{readingMinutes(post.body)} min read</span>
              {post.data.author && <span>By {post.data.author}</span>}
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.excerpt}</p>
            <div class="tags">
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
