---
import { getCollection, render } from "astro:content";
import ContentLayout from "@/layouts/ContentLayout.astro";
import { formatDate, readingMinutes, slugFromEntry } from "@/lib/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: slugFromEntry(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<ContentLayout title={post.data.title} description={post.data.excerpt} eyebrow="Blog">
  <div class="meta">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <span>{readingMinutes(post.body)} min read</span>
    {post.data.author && <span>By {post.data.author}</span>}
  </div>
  <div class="tags">
    {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
  <Content />
  <p><a href="/blog">Back to all posts</a></p>
</ContentLayout>
